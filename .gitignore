server/deploy.sh
server/Caddyfile

# Vendored libtorrent_flutter: keep source (src/, lib/, android/) AND the
# prebuilt native libs (they're required to build and are NOT reproducible on a
# Windows box — losing them broke the build once; keep them in git).
packages/libtorrent_flutter/**/build_win/
packages/libtorrent_flutter/**/*.so
packages/libtorrent_flutter/**/*.a
# ...except the bundled prebuilt Android .so files, which MUST be committed.
!packages/libtorrent_flutter/prebuilt/
!packages/libtorrent_flutter/prebuilt/**
!packages/libtorrent_flutter/prebuilt/**/*.so
packages/libtorrent_flutter/**/*.xcframework/

# beamctl live-debug session artifacts
.beamctl_ws
attach.log
attach.log.ctl

# The public source preview deliberately excludes native release binaries.
# Keep this after the private project's historical prebuilt exceptions.
packages/libtorrent_flutter/prebuilt/**/*.so
